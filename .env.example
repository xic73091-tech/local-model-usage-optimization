# =============================================================
# Local Model Optimizer - Environment Variables
# =============================================================
# Copy this file to .env and customize as needed.
# These values override the corresponding YAML config settings.

# --- Server ---
LMO_HOST=0.0.0.0
LMO_PORT=8000
LMO_WORKERS=1
LMO_RELOAD=false

# --- Model ---
LMO_DEFAULT_MODEL=
LMO_MODEL_DIR=models
LMO_AUTO_DOWNLOAD=false

# --- HuggingFace ---
# Required for downloading gated models from HF Hub
HF_TOKEN=
HF_HOME=

# --- Inference Defaults ---
LMO_N_CTX=4096
LMO_N_BATCH=512
LMO_N_GPU_LAYERS=-1
LMO_N_THREADS=0

# --- Generation Defaults ---
LMO_MAX_TOKENS=512
LMO_TEMPERATURE=0.7
LMO_TOP_P=0.9
LMO_TOP_K=40
LMO_REPEAT_PENALTY=1.1

# --- Scheduler ---
LMO_MAX_QUEUE_SIZE=1000
LMO_MAX_CONCURRENCY=4
LMO_MODEL_SELECT_STRATEGY=balanced
# Options: balanced | speed | quality | memory

# --- Monitoring ---
LMO_MONITORING_ENABLED=true
LMO_COLLECT_INTERVAL=1.0
LMO_GPU_MONITORING=true

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LMO_LOG_LEVEL=INFO
LMO_LOG_FILE=logs/app.log
LMO_LOG_COLORIZED=true

# --- Auth (optional) ---
# Enable API key authentication for production deployments
# Set to "true" to require API keys for all endpoints (except /health)
LMO_AUTH_ENABLED=false

# Comma-separated list of valid API keys
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Example: LMO_API_KEYS=sk-abc123,sk-def456
LMO_API_KEYS=

# --- CORS (Security) ---
# Allowed CORS origins (comma-separated)
# Default: http://localhost:3000,http://127.0.0.1:3000
# For development only: CORS_ORIGINS=*
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Rate Limiting ---
# Maximum requests per client IP per time window
LMO_RATE_LIMIT_REQUESTS=60
# Rate limit window in seconds
LMO_RATE_LIMIT_WINDOW=60

# --- Memory Optimization ---
# Optimization profile: minimal_vram | balanced | max_speed | quality
LMO_OPTIMIZATION_PROFILE=balanced

# Offload settings
LMO_OFFLOAD_GPU_LAYERS=-1
LMO_OFFLOAD_CPU_THREADS=4
LMO_OFFLOAD_DISK=false

# KV Cache settings
LMO_KV_CACHE_BITS=16
LMO_KV_CACHE_MAX_SIZE_GB=2.0
LMO_KV_PREFIX_SHARING=true

# Dynamic layer loading
LMO_DYNAMIC_MAX_GPU_LAYERS=20
LMO_DYNAMIC_PREFETCH=true

# --- llama-cpp-python build flags (for manual install) ---
# Uncomment and set these if building llama-cpp-python from source
# CMAKE_ARGS="-DLLAMA_CUBLAS=on"        # NVIDIA CUDA
# CMAKE_ARGS="-DLLAMA_METAL=on"         # Apple Metal
# CMAKE_ARGS="-DLLAMA_CLBLAST=on"       # OpenCL
# CMAKE_ARGS="-DLLAMA_HIPBLAS=on"       # AMD ROCm
# FORCE_CMAKE=1
