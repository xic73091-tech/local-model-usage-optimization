# =============================================================
# Local Model Optimizer - Environment Configuration
# =============================================================
# Copy this file to .env and customize:
#   cp .env.example .env
#
# IMPORTANT: NEVER commit .env to version control!
# .env contains secrets (API keys, tokens) that must stay private.
# =============================================================

# --- Server ---
# SECURITY: Bind to localhost (127.0.0.1) for local use only.
# Use 0.0.0.0 ONLY for container/docker deployments with proper network isolation.
LMO_HOST=127.0.0.1
LMO_PORT=8000

# --- Authentication ---
# SECURITY: Authentication is ENABLED by default. Do not disable in production.
LMO_AUTH_ENABLED=true
# Generate API keys: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Multiple keys: comma-separated (e.g., "key1,key2,key3")
LMO_API_KEYS=your-secret-key-here

# --- Model ---
LMO_DEFAULT_MODEL=
LMO_MODEL_DIR=./models/llm

# --- GPU ---
# auto | cuda | rocm | metal | cpu
LMO_GPU_BACKEND=auto

# --- Cache ---
LMO_CACHE_DIR=./.cache

# --- Rate Limiting ---
# Requests per window (default: 60)
LMO_RATE_LIMIT_REQUESTS=60
# Window in seconds (default: 60)
LMO_RATE_LIMIT_WINDOW=60
# Optional: Redis for multi-worker rate limiting
# LMO_REDIS_URL=redis://localhost:6379/0

# --- TLS/SSL (for production) ---
# LMO_SSL_KEYFILE=/path/to/key.pem
# LMO_SSL_CERTFILE=/path/to/cert.pem

# --- HuggingFace ---
# WARNING: Keep HF_TOKEN secret! Never share or commit it.
# Get your token at: https://huggingface.co/settings/tokens
HF_TOKEN=

# --- llama-cpp-python Build Flags ---
# Uncomment ONE of the following based on your GPU:
#
# NVIDIA (CUDA):
# CMAKE_ARGS="-DGGML_CUDA=on"
#
# AMD (ROCm) - Linux only:
# CMAKE_ARGS="-DGGML_HIP=on"
#
# Apple Silicon (Metal) - macOS only:
# CMAKE_ARGS="-DGGML_METAL=on"
#
# Intel (SYCL):
# CMAKE_ARGS="-DGGML_SYCL=on"
#
# Cross-platform (Vulkan):
# CMAKE_ARGS="-DGGML_VULKAN=on"
#
# CPU only (no GPU):
# CMAKE_ARGS=""
#
# Force reinstall after changing:
# pip install llama-cpp-python --force-reinstall --no-cache-dir


# =============================================================================
# SELF-LEARNING SYSTEM
# =============================================================================
# Enable/disable the self-learning system (default: true)
# LMO_LEARNING_ENABLED=true

# Cron schedule for daily learning cycle (default: 02:00)
# LMO_LEARNING_CRON_HOUR=2
# LMO_LEARNING_CRON_MINUTE=0

# How many days of findings to analyze (default: 7)
# LMO_LEARNING_DAYS_BACK=7

# GitHub token for higher API rate limits (optional, anonymous: 60 req/hr)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Semantic Scholar API key for higher rate limits (optional)
# SEMANTIC_SCHOLAR_API_KEY=
